# Local development environment — copy to `.env.local` and fill in.
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored. Every start-dev-<provider>.sh script sources it,
# then forces AI_PROVIDER to match the script it lives in, so you can keep all
# providers' settings here at once and just run the script you want.

# ---------------------------------------------------------------------------
# Default provider when running the plain ./start-dev.sh (ollama | openai | fake)
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama (local LLM) — used by start-dev-ollama.sh
# ---------------------------------------------------------------------------
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b

# ---------------------------------------------------------------------------
# OpenAI (cloud) — used by start-dev-openai.sh
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # optional: proxy / Azure gateway

# ---------------------------------------------------------------------------
# Ports (rarely need changing)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
